# ==============================================================================
# Customer Conversion Prediction System - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and customize values for your deployment.
# Never commit actual production secrets to version control.

# Flask Application Settings
FLASK_APP=server.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
HOST=127.0.0.1

# Session Security Secret Key (Generate a random 32+ character string in production)
SECRET_KEY=customer_conversion_admin_secret_key_change_in_production_2026

# Admin Authentication Credentials
# Username or email for admin login
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@conversion.ai

# Plaintext password (will be automatically hashed in memory on server startup)
ADMIN_PASSWORD=admin123

# Optional: Pre-hashed password (pbkdf2:sha256). If provided, takes precedence over ADMIN_PASSWORD
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('admin123'))"
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:1000000$your_hash_here

# Session Timeout (in seconds, default: 3600 = 1 hour)
SESSION_LIFETIME_SECONDS=3600
